{
  "name": "@usemeterkit/cli",
  "version": "0.3.0",
  "description": "Self-service check, diagnosis, verification, and devnet payment CLI for MeterKit",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanTorchia/meterkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/JuanTorchia/meterkit/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/JuanTorchia/meterkit/issues"
  },
  "type": "module",
  "bin": {
    "meterkit": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@solana/kit": "5.5.1",
    "@usemeterkit/core": "workspace:*",
    "@x402/fetch": "2.22.0",
    "@x402/svm": "2.22.0",
    "zod": "^4.0.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
