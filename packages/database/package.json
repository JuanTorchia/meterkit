{
  "name": "@usemeterkit/database",
  "version": "0.1.0",
  "description": "PostgreSQL receipt, idempotency and replay-protection store for MeterKit",
  "license": "Apache-2.0",
  "keywords": [
    "solana",
    "usdc",
    "x402",
    "postgresql",
    "payments"
  ],
  "homepage": "https://meterkit.juanchi.dev",
  "bugs": {
    "url": "https://github.com/JuanTorchia/meterkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanTorchia/meterkit.git",
    "directory": "packages/database"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@usemeterkit/core": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4"
  }
}
