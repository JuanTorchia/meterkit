{
  "name": "@usemeterkit/core",
  "version": "0.1.0",
  "description": "Strict payment, product and receipt contracts shared by MeterKit packages",
  "license": "Apache-2.0",
  "keywords": [
    "solana",
    "usdc",
    "x402",
    "payments",
    "mcp"
  ],
  "homepage": "https://meterkit.juanchi.dev",
  "bugs": {
    "url": "https://github.com/JuanTorchia/meterkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanTorchia/meterkit.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "^4.0.17"
  }
}
