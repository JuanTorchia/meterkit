{
  "name": "@meterkit/sdk",
  "version": "0.1.0",
  "description": "Non-custodial x402 USDC middleware for APIs and MCP tools on Solana",
  "license": "Apache-2.0",
  "keywords": [
    "solana",
    "usdc",
    "x402",
    "payments",
    "mcp",
    "express"
  ],
  "homepage": "https://meterkit.juanchi.dev",
  "bugs": {
    "url": "https://github.com/JuanTorchia/meterkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanTorchia/meterkit.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@meterkit/core": "workspace:*",
    "@solana/kit": "5.5.1",
    "@solana/sysvars": "5.5.1",
    "@x402/core": "2.21.0",
    "@x402/express": "2.21.0",
    "@x402/svm": "2.21.0",
    "express": "^5.1.0",
    "zod": "^4.0.17"
  },
  "peerDependencies": {
    "express": ">=5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3"
  }
}
