{
  "name": "meterkit-hono-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "check:unpaid": "meterkit check http://localhost:3000/premium --allow-localhost",
    "doctor": "meterkit doctor --project . --url http://localhost:3000/premium --allow-localhost",
    "verify": "meterkit verify http://localhost:3000/premium --network solana-devnet --mint 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU --recipient {{RECIPIENT}} --max-amount 10000 --allow-localhost",
    "pay:test": "meterkit pay http://localhost:3000/premium --keypair .local-wallets/payer.json --mint 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU --recipient {{RECIPIENT}} --max-amount 10000 --max-session 10000 --rpc-url https://api.devnet.solana.com --replay --yes"
  },
  "dependencies": {
    "@usemeterkit/database": "0.3.1",
    "@usemeterkit/sdk": "0.3.1",
    "@x402/hono": "2.22.0",
    "hono": "4.13.0",
    "@hono/node-server": "2.1.0"
  },
  "devDependencies": {
    "@usemeterkit/cli": "0.3.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
