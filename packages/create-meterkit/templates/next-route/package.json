{
  "name": "meterkit-next-api",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:unpaid": "meterkit check http://localhost:3000/api/premium --allow-localhost",
    "doctor": "meterkit doctor --project . --url http://localhost:3000/api/premium --allow-localhost",
    "verify": "meterkit verify http://localhost:3000/api/premium --network solana-devnet --mint 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU --recipient {{RECIPIENT}} --max-amount 10000 --allow-localhost",
    "pay:test": "meterkit pay http://localhost:3000/api/premium --keypair .local-wallets/payer.json --mint 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU --recipient {{RECIPIENT}} --max-amount 10000 --max-session 10000 --rpc-url https://api.devnet.solana.com --replay --yes"
  },
  "dependencies": {
    "@usemeterkit/database": "0.3.0",
    "@usemeterkit/sdk": "0.3.0",
    "@x402/next": "2.22.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@usemeterkit/cli": "0.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.3"
  }
}
