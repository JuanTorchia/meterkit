METERKIT_NETWORK=solana-devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
X402_FACILITATOR_URL=https://x402.org/facilitator
UPSTREAM_HOST_ALLOWLIST=api.open-meteo.com,api.github.com
USDC_MINT=
MERCHANT_WALLET=
DATABASE_URL=postgresql://meterkit:meterkit@localhost:5432/meterkit
# Hosting platforms usually inject PORT. GATEWAY_PORT remains the local fallback.
PUBLIC_GATEWAY_URL=http://localhost:3402
GATEWAY_PORT=3402
# Set to 1 only when the hosted gateway is behind one trusted reverse proxy.
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:3000
PAYMENT_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=60
FINALITY_POLL_MS=15000
