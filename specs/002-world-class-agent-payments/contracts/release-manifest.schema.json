{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usemeterkit.dev/schemas/release-manifest-v1.json",
  "title": "MeterKit Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "sourceCommit",
    "tag",
    "packages",
    "compatibilityReport",
    "sbomReferences",
    "provenanceStatus",
    "migrationImpact",
    "rollback"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tag": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "integrity", "supportStatus"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "integrity": { "type": "string", "minLength": 1 },
          "supportStatus": {
            "enum": [
              "primary",
              "supported",
              "experimental",
              "internal",
              "deprecated"
            ]
          },
          "provenanceReference": { "type": "string", "format": "uri" }
        }
      }
    },
    "compatibilityReport": { "type": "string", "minLength": 1 },
    "sbomReferences": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenanceStatus": {
      "enum": ["staged", "verified", "unavailable", "failed"]
    },
    "migrationImpact": { "enum": ["none", "compatible", "breaking"] },
    "publishedAt": { "type": "string", "format": "date-time" },
    "rollback": { "type": "string", "minLength": 1 }
  }
}
