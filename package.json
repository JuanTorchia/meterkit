{
  "name": "meterkit",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @usemeterkit/core build && pnpm --filter @usemeterkit/database build && pnpm --filter @usemeterkit/sdk build && pnpm --filter @usemeterkit/subscriptions build && pnpm --filter @usemeterkit/policy-webacy build && pnpm --filter @usemeterkit/pilot build",
    "predev": "pnpm build:packages",
    "dev": "pnpm --parallel --filter @usemeterkit/gateway --filter @usemeterkit/web dev",
    "lint": "eslint .",
    "pretypecheck": "pnpm build:packages",
    "typecheck": "pnpm -r typecheck",
    "pretest": "pnpm build:packages",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "pretest:e2e": "pnpm build:packages",
    "test:e2e": "playwright test",
    "wallet:devnet": "tsx scripts/create-devnet-wallet.ts",
    "pilot:check": "node scripts/pilot-check.mjs",
    "pilot:init": "pnpm --filter @usemeterkit/pilot build && node packages/pilot/dist/cli.js init",
    "pilot:verify": "pnpm --filter @usemeterkit/pilot build && node packages/pilot/dist/cli.js verify",
    "quickstart:clean": "node scripts/verify-clean-quickstarts.mjs",
    "initializer:devnet": "node scripts/verify-generated-devnet.mjs",
    "compatibility:verify": "node scripts/verify-compatibility.mjs",
    "docs:verify": "node scripts/verify-docs-parity.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "world-class:evidence": "node scripts/verify-world-class-evidence.mjs",
    "contributor:verify": "node scripts/verify-contributor-path.mjs",
    "create:meterkit": "pnpm --filter create-meterkit build && node packages/create-meterkit/dist/cli.js",
    "aaa:evidence": "node scripts/verify-aaa-evidence.mjs",
    "demo:verify": "node scripts/verify-public-dashboard.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "demo:institutional": "node scripts/record-institutional-demo.mjs",
    "evidence:grant": "node scripts/grant-evidence.mjs",
    "release:verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:verify && pnpm version:verify && pnpm contributor:verify && pnpm build && pnpm quickstart:clean && pnpm compatibility:verify && pnpm benchmark && pnpm world-class:evidence && pnpm test:e2e && pnpm audit --prod --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:verify": "node scripts/verify-version-claims.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.54.2",
    "@solana/kit": "5.5.1",
    "@types/node": "^24.3.0",
    "bs58": "6.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "4.23.11",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  }
}
